# ---------------------------------------------------------------------------
# Optional LLM backend. Without a key the agent falls back to a deterministic
# rule-based intent router, so every capability still works offline.
# Any OpenAI-compatible endpoint is supported (OpenAI, DeepSeek, Qwen, vLLM...).
# ---------------------------------------------------------------------------
DS_AGENT_LLM_BASE_URL=https://api.openai.com/v1
DS_AGENT_LLM_API_KEY=
DS_AGENT_LLM_MODEL=gpt-4o-mini

# Warehouse file used by the demo and the web UI (DuckDB database file).
DS_AGENT_WAREHOUSE=demo_data/warehouse.duckdb
# Directory where reports and charts are written.
DS_AGENT_ARTIFACT_DIR=artifacts
